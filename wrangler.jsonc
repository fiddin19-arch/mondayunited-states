{
  // Mondayunited States — konfigurasi Cloudflare Workers
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mondayunited-states",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "DIR", "class_name": "Directory" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Directory"] }
  ],
  "observability": { "enabled": true }
}
